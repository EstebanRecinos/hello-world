{
  "$description": "ORBITA-LINK design tokens (W3C Design Tokens format). Single source of truth: web CSS is generated from this file (scripts/gen_tokens.py) and a future native app (React Native / SwiftUI / Compose) should consume this same JSON.",
  "color": {
    "$type": "color",
    "light": {
      "ink": { "$value": "#16202E", "$description": "Tinta de bitácora — texto y trazos" },
      "paper": { "$value": "#F4F6FA", "$description": "Papel técnico — fondo" },
      "surface": { "$value": "#FFFFFF", "$description": "Superficie — tarjetas" },
      "line": { "$value": "#C8D1DE", "$description": "Líneas y bordes" },
      "muted": { "$value": "#4D5B70", "$description": "Texto secundario (6.4:1 sobre paper)" },
      "accent": { "$value": "#8A5F00", "$description": "Ámbar de rampa — acción y progreso (4.7:1 sobre accent-soft)" },
      "accent-ink": { "$value": "#FFFFFF", "$description": "Texto sobre accent" },
      "accent-soft": { "$value": "#F5EAD0", "$description": "Fondo suave del acento" },
      "ok": { "$value": "#166339", "$description": "Verde de confirmación (6.1:1 sobre ok-soft)" },
      "ok-soft": { "$value": "#DDEFE5" },
      "warn": { "$value": "#A03C32", "$description": "Rojo de aviso (5.3:1 sobre warn-soft)" },
      "warn-soft": { "$value": "#F6E2E0" },
      "chip": { "$value": "#E6EAF2" },
      "focus": { "$value": "#1857C3", "$description": "Azul de foco — solo anillo de foco, nunca decorativo" }
    },
    "dark": {
      "ink": { "$value": "#E8EDF6" },
      "paper": { "$value": "#0D1526" },
      "surface": { "$value": "#16203A" },
      "line": { "$value": "#33415E" },
      "muted": { "$value": "#9AA7BD", "$description": "7.5:1 sobre paper" },
      "accent": { "$value": "#F0A32B", "$description": "7.3:1 sobre accent-soft" },
      "accent-ink": { "$value": "#14100A" },
      "accent-soft": { "$value": "#2B2413" },
      "ok": { "$value": "#57CF90", "$description": "7.3:1 sobre ok-soft" },
      "ok-soft": { "$value": "#14301F" },
      "warn": { "$value": "#F08A7E", "$description": "6.6:1 sobre warn-soft" },
      "warn-soft": { "$value": "#331A17" },
      "chip": { "$value": "#202C47" },
      "focus": { "$value": "#7FB2FF" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "8px", "$description": "Inputs y botones" },
    "card": { "$value": "10px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "target": { "$value": "44px", "$description": "Objetivo táctil mínimo (WCAG 2.2)" },
    "control": { "$value": "48px", "$description": "Altura de controles" }
  },
  "type": {
    "family": {
      "$type": "fontFamily",
      "data": { "$value": ["ui-monospace", "SF Mono", "Cascadia Code", "Menlo", "monospace"], "$description": "Datos, precios, marca, etiquetas" },
      "text": { "$value": ["system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "Cuerpo y formularios" }
    },
    "scale": {
      "$type": "dimension",
      "display": { "$value": "1.45rem", "$description": "peso 650" },
      "section": { "$value": "1.1rem", "$description": "peso 650" },
      "body": { "$value": "1rem", "$description": "peso 400 — nunca menor a 16px" },
      "hint": { "$value": "0.9rem" },
      "data": { "$value": "0.8rem", "$description": "peso 650, mayúsculas espaciadas" }
    }
  },
  "motion": {
    "$type": "duration",
    "quick": { "$value": "120ms", "$description": "Hover y foco" },
    "step": { "$value": "200ms", "$description": "Transición direccional entre pasos" },
    "moment": { "$value": "280ms", "$description": "El único momento celebratorio: reserva confirmada" }
  }
}
