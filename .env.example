# Copy to .env and adjust. All settings are prefixed ORBITA_.
ORBITA_DATABASE_URL=postgresql+psycopg://orbita:orbita@localhost:5432/orbita
ORBITA_JWT_SECRET=dev-secret-change-me
ORBITA_JWT_TTL_MINUTES=60
ORBITA_ENABLE_DEV_AUTH=true

# Matching tolerances (v1 engine)
ORBITA_MATCHING_INCLINATION_TOLERANCE_DEG=1.5
ORBITA_MATCHING_ALTITUDE_TOLERANCE_KM=50

# Pricing multipliers (live in config, not code)
ORBITA_PRICING_URGENCY_DAYS_THRESHOLD=90
ORBITA_PRICING_URGENCY_MULTIPLIER=1.25
ORBITA_PRICING_ATYPICAL_VOLUME_DENSITY_KG_M3=250
ORBITA_PRICING_ATYPICAL_VOLUME_MULTIPLIER=1.15
ORBITA_PRICING_REGULATORY_RISK_MULTIPLIER=1.20
